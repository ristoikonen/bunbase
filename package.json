{
  "name": "chatandbun",
  "version": "1.0.0",
  "main": "server.ts",
  "module": "server.ts",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "description": "API with AI chat powered by Bun, TypeScript, and Gemini API",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun run server.ts",
    "build:windows": "bun build --compile --target=bun-windows-x64 ./server.ts --outfile ./bunimages.exe"
  },
  "type": "module"
}
